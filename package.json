{
  "name": "contract-fixtures-workspace",
  "private": true,
  "workspaces": [
    "packages/ts",
    "example/provider"
  ],
  "scripts": {
    "build": "npm run build -w packages/ts",
    "lint": "npm run lint -w packages/ts",
