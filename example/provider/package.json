{
  "name": "contract-fixtures-example-provider",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-build && tsc -p tsconfig.json && node --test --test-reporter=spec .test-build/test/*.test.js",
    "contract": "npm run reset && npm test && npm run check",
    "reset": "contract-fixtures reset --side provider --dir ../contracts",
    "check": "contract-fixtures check --side provider --dir ../contracts"
  },
  "devDependencies": {
    "@t09tanaka/contract-fixtures": "*",
    "@types/node": "^20.19.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3"
  }
}
