{
  "format": 1,
  "name": "receipt.downloaded",
  "description": "The receipt of an order is a download with a file name",
  "request": {
    "method": "GET",
    "path": "/orders/ord_mv3svam01/receipt",
    "headers": {
      "authorization": "<token:customer-1>"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "content-disposition": "attachment; filename=\"receipt-ord_mv3svam01.json\"",
      "cache-control": "private, no-store"
    },
    "body": {
      "order_id": "ord_mv3svam01",
      "lines": [
        {
          "sku": "tea-100",
          "quantity": 2
        }
      ],
      "total_minor": 1200
    }
  },
  "volatile": [
    {
      "path": "request.path",
      "pattern": "^/orders/ord_[a-z0-9]+/receipt$"
    },
    {
      "path": "response.body.order_id",
      "pattern": "^ord_[a-z0-9]+$"
    },
    {
      "path": "response.headers.content-disposition",
      "pattern": "^attachment; filename=\"receipt-ord_[a-z0-9]+\\.json\"$"
    }
  ]
}
