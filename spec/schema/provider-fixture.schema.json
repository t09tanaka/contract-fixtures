{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t09tanaka/contract-fixtures/blob/main/spec/schema/provider-fixture.schema.json",
  "title": "contract-fixtures provider fixture (format 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "name",
    "description",
    "request",
    "response"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "path"
      ],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "type": [
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "headers": {
          "$ref": "#/$defs/headers"
        },
        "body": {
          "type": [
            "boolean",
            "number",
            "string",
            "array",
            "object"
          ]
        }
      }
    },
    "volatile": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/volatilePath"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "pattern"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/volatilePath"
              },
              "pattern": {
                "type": "string",
                "maxLength": 1000
              }
            }
          }
        ]
      }
    },
    "secret": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(request|response)\\.(headers|body)(\\.(\\*|[^.*]+))*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^<[a-z][a-z0-9-]*:[A-Za-z0-9._-]+>$"
      }
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^A-Z]+$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "volatilePath": {
      "type": "string",
      "pattern": "^(request|response)\\.[^.*]+(\\.(\\*|[^.*]+))*(\\.\\*\\*)?(\\.(\\*|[^.*]+))*$"
    }
  }
}
