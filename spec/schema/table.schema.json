{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t09tanaka/contract-fixtures/blob/main/spec/schema/table.schema.json",
  "title": "contract-fixtures table (format 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "name",
    "description",
    "rows"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
