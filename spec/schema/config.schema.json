{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t09tanaka/contract-fixtures/blob/main/spec/schema/config.schema.json",
  "title": "contract-fixtures configuration of a contracts directory (format 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "readers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\*?$"
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\*?$"
            }
          }
        }
      }
    }
  }
}
