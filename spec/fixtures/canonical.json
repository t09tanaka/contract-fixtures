{
  "description": "`input` is JSON text. `pretty` is how it is written to a fixture file; `compact` is how it is printed inside a difference.",
  "cases": [
    {
      "case": "integer-valued numbers have no fraction",
      "input": "{\"a\":1.0,\"b\":2.50,\"c\":-0.5,\"d\":1e3}",
      "pretty": "{\n  \"a\": 1,\n  \"b\": 2.5,\n  \"c\": -0.5,\n  \"d\": 1000\n}\n",
      "compact": "{\"a\":1,\"b\":2.5,\"c\":-0.5,\"d\":1000}"
    },
    {
      "case": "key order is kept when writing, sorted when printing a difference",
      "input": "{\"b\":1,\"a\":{\"d\":[],\"c\":{}}}",
      "pretty": "{\n  \"b\": 1,\n  \"a\": {\n    \"d\": [],\n    \"c\": {}\n  }\n}\n",
      "compact": "{\"a\":{\"c\":{},\"d\":[]},\"b\":1}"
    },
    {
      "case": "strings",
      "input": "[\"紅茶\",\"line\\nbreak\\ttab\",\"quote\\\"back\\\\slash\",\"\\u0001\",\"a/b\"]",
      "pretty": "[\n  \"紅茶\",\n  \"line\\nbreak\\ttab\",\n  \"quote\\\"back\\\\slash\",\n  \"\\u0001\",\n  \"a/b\"\n]\n",
      "compact": "[\"紅茶\",\"line\\nbreak\\ttab\",\"quote\\\"back\\\\slash\",\"\\u0001\",\"a/b\"]"
    },
    {
      "case": "scalars",
      "input": "[null,true,false,0,\"\"]",
      "pretty": "[\n  null,\n  true,\n  false,\n  0,\n  \"\"\n]\n",
      "compact": "[null,true,false,0,\"\"]"
    },
    {
      "case": "keys that are array indexes come first in ascending order, the rest keep their order",
      "input": "{\"b\":1,\"10\":2,\"9\":3,\"a\":4,\"01\":5,\"-1\":6,\"4294967295\":7,\"0\":8}",
      "pretty": "{\n  \"0\": 8,\n  \"9\": 3,\n  \"10\": 2,\n  \"b\": 1,\n  \"a\": 4,\n  \"01\": 5,\n  \"-1\": 6,\n  \"4294967295\": 7\n}\n",
      "compact": "{\"-1\":6,\"0\":8,\"01\":5,\"10\":2,\"4294967295\":7,\"9\":3,\"a\":4,\"b\":1}"
    },
    {
      "case": "characters outside the basic plane and combining characters are written as they are",
      "input": "{\"\\ud83d\\ude00\": \"e\\u0301\", \"\\uff21\": \"\\u00e9 \\ud83d\\udc69\\u200d\\ud83d\\udcbb\"}",
      "pretty": "{\n  \"😀\": \"é\",\n  \"Ａ\": \"é 👩‍💻\"\n}\n",
      "compact": "{\"😀\":\"é\",\"Ａ\":\"é 👩‍💻\"}"
    },
    {
      "case": "a lone surrogate is written as an escape",
      "input": "[\"a\\ud83db\",\"\\udc00\"]",
      "pretty": "[\n  \"a\\ud83db\",\n  \"\\udc00\"\n]\n",
      "compact": "[\"a\\ud83db\",\"\\udc00\"]"
    },
    {
      "case": "the largest and smallest supported integers",
      "input": "[9007199254740991,-9007199254740991,9007199254740991.0]",
      "pretty": "[\n  9007199254740991,\n  -9007199254740991,\n  9007199254740991\n]\n",
      "compact": "[9007199254740991,-9007199254740991,9007199254740991]"
    },
    {
      "case": "numbers are written as JavaScript writes them, also beyond 2^53",
      "input": "[123456789012345680000, 1e21, 1e300, 9007199254740993, -9007199254740993, 1152921504606846976, 1e-7, 0.000001, 1.5e25, -0.0, 5e-324, 100.0, 1.0e2, 0.1, 123456.789e3, 9007199254740991, 1e20]",
      "pretty": "[\n  123456789012345680000,\n  1e+21,\n  1e+300,\n  9007199254740992,\n  -9007199254740992,\n  1152921504606847000,\n  1e-7,\n  0.000001,\n  1.5e+25,\n  0,\n  5e-324,\n  100,\n  100,\n  0.1,\n  123456789,\n  9007199254740991,\n  100000000000000000000\n]\n",
      "compact": "[123456789012345680000,1e+21,1e+300,9007199254740992,-9007199254740992,1152921504606847000,1e-7,0.000001,1.5e+25,0,5e-324,100,100,0.1,123456789,9007199254740991,100000000000000000000]"
    },
    {
      "case": "numbers beyond 2^53 inside an object",
      "input": "{\"b\": 1e21, \"a\": {\"n\": 18014398509481984, \"m\": -1e22}}",
      "pretty": "{\n  \"b\": 1e+21,\n  \"a\": {\n    \"n\": 18014398509481984,\n    \"m\": -1e+22\n  }\n}\n",
      "compact": "{\"a\":{\"m\":-1e+22,\"n\":18014398509481984},\"b\":1e+21}"
    }
  ]
}
