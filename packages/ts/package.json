{
  "name": "@t09tanaka/contract-fixtures",
  "version": "0.1.0",
  "description": "Shared request/response fixtures that keep an API and its clients in step: the provider verifies them against real responses, the consumer reads them.",
  "keywords": [
    "contract",
    "contract-testing",
    "fixtures",
    "api",
    "testing"
  ],
  "license": "MIT",
  "author": "Takuto Tanaka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t09tanaka/contract-fixtures.git",
    "directory": "packages/ts"
  },
  "homepage": "https://github.com/t09tanaka/contract-fixtures#readme",
  "bugs": "https://github.com/t09tanaka/contract-fixtures/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "contract-fixtures": "dist/bin.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test --test-reporter=spec .test-build/test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
